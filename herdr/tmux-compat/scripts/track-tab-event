#!/bin/sh
set -eu

[ -n "${HERDR_PLUGIN_EVENT_JSON:-}" ] || exit 0

state_dir=${HERDR_PLUGIN_STATE_DIR:?}
state_file="$state_dir/tab-mru.json"
lock_dir="$state_dir/.tab-mru.lock"
mkdir -p "$state_dir"

attempt=0
while ! mkdir "$lock_dir" 2>/dev/null; do
  attempt=$((attempt + 1))
  [ "$attempt" -lt 100 ] || exit 0
  sleep 0.01
done
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT HUP INT TERM

if [ -s "$state_file" ]; then
  state=$(cat "$state_file")
else
  state='{}'
fi

case "${HERDR_PLUGIN_EVENT:-}" in
  tab.focused)
    workspace_id=$(printf '%s\n' "$HERDR_PLUGIN_EVENT_JSON" | jq -r '.data.workspace_id // empty')
    tab_id=$(printf '%s\n' "$HERDR_PLUGIN_EVENT_JSON" | jq -r '.data.tab_id // empty')
    [ -n "$workspace_id" ] && [ -n "$tab_id" ] || exit 0
    updated=$(printf '%s\n' "$state" | jq -c \
      --arg workspace_id "$workspace_id" \
      --arg tab_id "$tab_id" \
      '.[$workspace_id] = ([$tab_id] + ((.[$workspace_id] // []) | map(select(. != $tab_id))))')
    ;;
  tab.closed)
    tab_id=$(printf '%s\n' "$HERDR_PLUGIN_EVENT_JSON" | jq -r '.data.tab_id // empty')
    [ -n "$tab_id" ] || exit 0
    updated=$(printf '%s\n' "$state" | jq -c --arg tab_id "$tab_id" '
      to_entries
      | map(.value |= map(select(. != $tab_id)))
      | map(select(.value | length > 0))
      | from_entries
    ')
    ;;
  *)
    exit 0
    ;;
esac

temporary=$(mktemp "$state_dir/tab-mru.XXXXXX")
printf '%s\n' "$updated" > "$temporary"
mv "$temporary" "$state_file"
